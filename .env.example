# Copia in .env (che non va nel repository) e riempi.
# Per l'AI basta UNA delle due. Senza nessuna, il server usa le risposte di riserva.
ANTHROPIC_API_KEY=
# Token dell'abbonamento Claude: sul server lancia `claude setup-token` e incolla qui il risultato
CLAUDE_CODE_OAUTH_TOKEN=

# Modello e modalità AI (auto: AI se c'è una chiave; off: solo regole di riserva)
AI_MODEL=claude-sonnet-5-5
AI_MODE=auto

# Server (nel container questi valori sono già impostati dal Dockerfile)
PORT=3210
# DATA_DIR=/data
# CONTENT_DIR=/app/content
# WEB_DIST=/app/app/web/dist
