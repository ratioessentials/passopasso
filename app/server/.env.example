# Porta del server (la 8787 è già occupata sul server)
PORT=3210
# Autenticazione AI: una delle due
ANTHROPIC_API_KEY=
# oppure il token generato con `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# Modello e sforzo di ragionamento (low = risposte più rapide)
AI_MODEL=claude-sonnet-5-5
AI_EFFORT=low
# auto (default) | off (solo regole, nessuna chiamata) | sdk | cli
AI_MODE=auto
# Timeout di una chiamata all'AI in millisecondi (poi seduta di riserva)
AI_TIMEOUT_MS=25000
# Percorsi (default relativi ad app/server)
CONTENT_DIR=../../content
DATA_DIR=./data
WEB_DIST=../web/dist
# Fuso orario per "oggi"
TZ=Europe/Rome
# Notifiche push (Web Push). Genera le chiavi con: npx web-push generate-vapid-keys
# Se mancano, il server le genera una volta e le salva nel database.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ciao@passopasso.app
# off = niente scheduler dei promemoria (es. in sviluppo)
PUSH_SCHEDULER=on
# Strava (https://www.strava.com/settings/api): Authorization Callback Domain = passopasso.andreavallieri.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
